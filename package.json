{
  "name": "lambiiz-hd2d",
  "version": "0.1.0",
  "private": true,
  "description": "A 2.5D (HD-2D style) browser RPG with an ATB / exact-preview combat system.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/publish.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "shots": "node tools/screenshots.mjs",
    "test": "rolldown tests/sim.test.ts --file .test-out/sim.test.mjs --format esm --platform node > /dev/null && node .test-out/sim.test.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
